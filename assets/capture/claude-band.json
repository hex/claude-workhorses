{
  "title": "The wh badge and band in Claude Code while a run goes",
  "description": "Claude Code runs wh in bash mode. The band above the prompt names the run and its time; the footer badge counts the copy, then spins while the job runs, and both go when it ends. Each state lasts 2.5 seconds.",
  "provenance": {
    "checkout_head": "1dedbc8ffb903dee551a95f4e6095ff4aea92547",
    "host": "alpha, a real workhorse; its ssh target stays outside the capture",
    "versions": {
      "host": {
        "arch": "x86_64",
        "cores": 6,
        "ram_gb": 16
      },
      "go": "go version go1.27.4 darwin/amd64",
      "claude": "2.1.332 (Claude Code)"
    },
    "commands": [
      "! wh -- gtimeout 5m go test -bench=. ./..."
    ],
    "capture_commands": [
      "bash assets/capture/claude-band.sh",
      "tmux -L svgcap capture-pane -p -e"
    ],
    "crop": "Each file holds only the rows its frame shows, captured with -S and -E; all 110 columns remain.",
    "themes": "Each theme is its own Claude Code session and run.",
