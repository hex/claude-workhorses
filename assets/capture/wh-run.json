{
  "title": "wh runs a repository's tests on a workhorse, then runs them again after an edit",
  "description": "A terminal runs wh in a small Go repository. The first run picks the workhorse alpha, copies every file and runs the tests. After a one-line edit, the second run sends only the edited file. Each state lasts 2.5 seconds.",
  "provenance": {
    "checkout_head": "1dedbc8ffb903dee551a95f4e6095ff4aea92547",
    "host": "alpha, a real workhorse; its ssh target stays outside the capture",
    "versions": {
      "host": {
        "arch": "x86_64",
        "cores": 6,
        "ram_gb": 16
      },
      "go": "go version go1.27.4 darwin/amd64"
    },
    "commands": [
      "wh -- gtimeout 5m go test -v ./...",
      "echo 'func TestSub(t *testing.T) { if Sub(5, 3) != 2 { t.Fatal(\"Sub(5, 3) != 2\") } }' >> calc_test.go",
      "wh -- gtimeout 5m go test -v ./..."
    ],
    "capture_commands": [
      "bash assets/capture/wh-run.sh",
      "tmux -L svgcap capture-pane -p -e"
    ],
    "crop": "Each file holds only the rows its frame shows, captured with -S and -E; all 110 columns remain.",
    "themes": "One capture serves both themes; the shell prints no colors of its own.",
    "terminal_defaults": {
      "light": [
        "#302a24",
        "#fbf6e9"
      ],
      "dark": [
        "#eeeeee",
        "#191919"
      ]
    },
    "home_path": "The current home directory prefix is replaced with ~ when capture files are written."
  },
