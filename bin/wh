#!/bin/bash
# ABOUTME: Runs a command on a workhorse against a verified copy of the current git repo, in the caller's subdirectory.
# ABOUTME: Usage: wh [host] -- <command...>; no host picks by load. Exit: the command's, 3 BLOCKED, 2 usage.
set -euo pipefail

usage() {
  echo "usage: wh [host] -- <command...>  (no host: a free workhorse, by load)" >&2
  exit 2
}

host=auto
if [ "${1:-}" != -- ]; then
  [ $# -gt 0 ] || usage
  host=$1
  shift
fi
[ "${1:-}" = -- ] || usage
shift
[ $# -gt 0 ] || usage

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "wh: $PWD is not inside a git repository" >&2
  exit 2
}

# mirror.sh copies the whole repository and runs the command in this subfolder of the copy.
exec "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../scripts/mirror.sh" run "$host" "$PWD" "$@"
