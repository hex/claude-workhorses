#!/bin/bash
# ABOUTME: Runs a command on a workhorse against a verified copy of the current git repo, in the caller's subdirectory.
# ABOUTME: Usage: wh [host] [--timeout <limit>] -- <command...>; no host picks by load; wh ps, wh stop <run>. Exit: the command's, 124 past the limit, 3 BLOCKED, 2 usage.
set -euo pipefail

usage() {
  echo "usage: wh [host] [--timeout <limit>] -- <command...>  (no host: a free workhorse, by load; limit: 90s, 30m, 2h)" >&2
  echo "       wh ps          (the wh runs going from this machine)" >&2
  echo "       wh stop <run>  (ends a run, its job on the host included; <run> is the number wh ps shows)" >&2
  exit 2
}

mirror=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../scripts/mirror.sh
case "${1:-}" in
  ps | stop) exec "$mirror" "$@" ;;
esac

host=auto limit=0
while [ "${1:-}" != -- ]; do
  [ $# -gt 0 ] || usage
  case "$1" in
    --timeout)
      [ $# -ge 2 ] || usage
      if ! [[ $2 =~ ^([1-9][0-9]*)([smh])$ ]]; then
        echo "wh: --timeout takes a whole number of seconds, minutes or hours (90s, 30m, 2h), not \"$2\"" >&2
        exit 2
      fi
      # Shell arithmetic wraps past 19 digits, so the length is checked before any sum.
      if [ ${#BASH_REMATCH[1]} -le 6 ]; then
        case "${BASH_REMATCH[2]}" in
          s) limit=${BASH_REMATCH[1]} ;;
          m) limit=$((BASH_REMATCH[1] * 60)) ;;
          h) limit=$((BASH_REMATCH[1] * 3600)) ;;
        esac
      fi
      if [ ${#BASH_REMATCH[1]} -gt 6 ] || [ "$limit" -gt 604800 ]; then
        echo "wh: --timeout is at most a week (168h), not \"$2\"" >&2
        exit 2
      fi
      shift 2 ;;
    *)
      [ "$host" = auto ] || usage
      host=$1
      shift ;;
  esac
done
shift
[ $# -gt 0 ] || usage

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "wh: $PWD is not inside a git repository" >&2
  exit 2
}

# mirror.sh copies the whole repository and runs the command in this subfolder of the copy.
exec "$mirror" run --timeout "$limit" "$host" "$PWD" "$@"
