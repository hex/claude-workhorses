# PATH for every zsh, including non-interactive `ssh <workhorse> cmd` runs:
# user tools (claude, npm globals) in ~/.local/bin, MacPorts in /opt/local,
# plus per-tool homes for Rust, .NET, bun and opencode, and MacPorts'
# ImageMagick 7, which installs `magick` outside /opt/local/bin.
export DOTNET_ROOT="$HOME/.dotnet"
export GEM_HOME="$HOME/.local/share/gem"
# Headless browser tests read CHROME_BIN; tools.sh points this wrapper at the installed Chrome for Testing.
export CHROME_BIN="$HOME/.local/bin/chrome"
typeset -U path
path=($HOME/.local/bin $HOME/.cargo/bin $DOTNET_ROOT $HOME/.bun/bin $HOME/.opencode/bin /opt/local/lib/ImageMagick7/bin /opt/local/bin /opt/local/sbin $path)
export PATH

# Unity CLI
if [ -f "$HOME/.unity/env" ]; then . "$HOME/.unity/env"; fi
