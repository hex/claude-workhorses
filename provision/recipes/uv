#!/bin/bash
# ABOUTME: Recipe: uv, the Python package manager, from its official installer into ~/.local/bin.
# ABOUTME: install takes no arguments and leaves a uv already on the PATH as it is. probe prints "uv <version>".
set -euo pipefail
. "$(dirname "$0")/../recipe-lib.sh"

install() {
  command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
}

probe() {
  # One release reads differently by system: a Mac's uv ends "(<commit> <date> aarch64-apple-darwin)",
  # a Linux build has no commit and prints less or nothing after the version. Only the version stays,
  # so hosts of either system and architecture compare.
  echo "uv $(uv --version 2>/dev/null | sed 's/ (.*)$//' || echo missing)"
}

"$@"
