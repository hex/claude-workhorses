#!/bin/bash
# ABOUTME: Recipe: Google's bundletool jar at one version, bundletool <version> (bundletool 1.18.3), with a ~/.local/bin/bundletool command.
# ABOUTME: install downloads the version once; the command runs it with the java on the PATH. probe prints "bundletool <jar>".
set -euo pipefail
. "$(dirname "$0")/../recipe-lib.sh"

# Prints where the jar of version $1 goes. It exists only once its download finished, which install
# skips on and probe reports.
jar_path() {
  echo "$HOME/.local/share/bundletool/bundletool-all-${1:?bundletool takes a version, like 1.18.3}.jar"
}

install() {
  local version=${1:?bundletool takes a version, like 1.18.3} jar
  jar=$(jar_path "$version")
  if ! [ -f "$jar" ]; then
    mkdir -p "$(dirname "$jar")"
    # A download cut short stays under the .part name, so no run takes it for the jar.
    curl -fsSL -o "$jar.part" "https://github.com/google/bundletool/releases/download/$version/bundletool-all-$version.jar"
    mv "$jar.part" "$jar"
  fi
  mkdir -p "$HOME/.local/bin"
  printf '#!/bin/sh\nexec java -jar "%s" "$@"\n' "$jar" >"$HOME/.local/bin/bundletool"
  chmod +x "$HOME/.local/bin/bundletool"
}

probe() {
  local jar
  jar=$(jar_path "${1:-}")
  if [ -f "$jar" ]; then echo "bundletool ${jar##*/}"; else echo "bundletool missing"; fi
}

"$@"
