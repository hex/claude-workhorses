#!/bin/bash
# ABOUTME: Recipe: Rust through rustup, installed into ~/.cargo without touching shell files.
# ABOUTME: install takes no arguments and leaves an installed toolchain as it is. probe prints "rustc <version>".
set -euo pipefail
. "$(dirname "$0")/../recipe-lib.sh"

install() {
  if ! [ -x "$HOME/.cargo/bin/rustup" ]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
  fi
  env_snippet rustup <<<'workhorse_path_add "$HOME/.cargo/bin"'
}

probe() {
  echo "rustc $("$HOME/.cargo/bin/rustc" --version 2>/dev/null || echo missing)"
}

"$@"
