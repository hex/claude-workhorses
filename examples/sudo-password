#!/bin/sh
# The claude-workhorses sudo-password helper: copy it to ~/.config/claude-workhorses/sudo-password,
# then chmod 700 it. provision/sync.sh runs it with a host name as its one argument and reads the
# workhorse user's sudo password from its output.
#
# This one reads the password from the login keychain. Store each host's password once with:
#   security add-generic-password -a <host> -s claude-workhorses-sudo -w
exec security find-generic-password -a "$1" -s claude-workhorses-sudo -w
